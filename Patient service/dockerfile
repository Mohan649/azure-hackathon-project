# Step 1: Tell Docker to use Python
FROM python:3.11-slim

# Step 2: Set the folder inside the container where files will live
WORKDIR /app

# Step 3: Copy our requirements text file into the container
COPY requirements.txt .

# Step 4: Install the Python packages
RUN pip install --no-cache-dir -r requirements.txt

# Step 5: Copy the rest of our application code into the container
COPY main.py .

# Step 6: Expose port 8000 so we can access the app
EXPOSE 8000

# Step 7: Run the application
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]